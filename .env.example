# --- App ---
APP_NAME=Lexus Personal Hub
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///.data/lexus_hub.db
TIMEZONE=America/Toronto
DASHBOARD_REFRESH_SECONDS=60
DASHBOARD_URL=
MAP_ROUTER_URL=https://router.project-osrm.org
PROVIDER=mock
POLL_INTERVAL_MINUTES=15
TRIP_IDLE_CLOSE_MINUTES=30
MIN_TRIP_DELTA_KM=0.2
MAX_SNAPSHOT_GAP_HOURS=6
# Trip maps require both of these to be true. Keep the dashboard private (for example via Tailscale).
STORE_LOCATION=false
SHOW_EXACT_LOCATION=false

# --- Vehicle / maintenance ---
VEHICLE_DISPLAY_NAME=My Lexus
LAST_SERVICE_ODOMETER_KM=
SERVICE_INTERVAL_KM=8000
LOW_FUEL_PERCENT=20
LOW_RANGE_KM=80
LOW_TIRE_PSI=30
ALERT_OPENINGS=false

# --- Home Assistant provider ---
# Set PROVIDER=home_assistant, then fill these in.
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_VERIFY_SSL=true
HA_ODOMETER_ENTITY=
HA_FUEL_ENTITY=
HA_RANGE_ENTITY=
# Optional. If blank, Current Location / Last Parked Location are auto-discovered.
HA_LOCATION_ENTITY=
HA_SPEED_ENTITY=
HA_LAST_UPDATE_ENTITY=

# --- Discord ---
# Webhook is enough for automatic alerts.
DISCORD_WEBHOOK_URL=
# Bot token enables slash commands. Keep it private.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
